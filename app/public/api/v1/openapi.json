{
  "openapi": "3.1.0",
  "info": {
    "title": "Contraflow API",
    "version": "1.0.0",
    "description": "Record offchain obligations for your customers, find netting loops, collect each party's certificate signature and apply certificates on Arc. Contraflow never signs for anyone: every obligation and certificate carries the party's own signature, and you act for a party only under a permission it signed. Test keys (`cfk_test_`) use Arc testnet. Amounts are integer strings in the currency's minor units; all integers in JSON are decimal strings."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/permissions/typed-data": {
      "get": {
        "summary": "Build a permission to sign",
        "description": "Returns the EIP-712 typed data a party signs to grant you scopes.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "party",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Address"
            }
          },
          {
            "name": "scopes",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            "description": "Bitmask: read 1, propose 2, deliverSignatures 4."
          },
          {
            "name": "expiresAt",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unix seconds, at most one year ahead."
          },
          {
            "name": "nonce",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Bytes32"
            }
          }
        ]
      }
    },
    "/permissions": {
      "post": {
        "summary": "Store a signed permission",
        "description": "Verifies the party's signature (ECDSA, or ERC-1271 for a smart account) and stores the grant.",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "permission": {
                    "type": "object",
                    "properties": {
                      "party": {
                        "$ref": "#/components/schemas/Address"
                      },
                      "tenantId": {
                        "$ref": "#/components/schemas/Bytes32"
                      },
                      "scopes": {
                        "type": "integer"
                      },
                      "expiresAt": {
                        "type": "string"
                      },
                      "nonce": {
                        "$ref": "#/components/schemas/Bytes32"
                      }
                    },
                    "required": [
                      "party",
                      "tenantId",
                      "scopes",
                      "expiresAt",
                      "nonce"
                    ]
                  },
                  "signature": {
                    "$ref": "#/components/schemas/Hex"
                  }
                },
                "required": [
                  "permission",
                  "signature"
                ]
              }
            }
          }
        }
      }
    },
    "/permissions/{permissionId}": {
      "delete": {
        "summary": "Revoke a permission",
        "description": "Stops you acting for the party under this grant.",
        "responses": {
          "204": {
            "description": "No content"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "permissionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/obligations/proposals": {
      "post": {
        "summary": "Propose an obligation",
        "description": "Submits an obligation signed by the proposing party. The response includes `typedData`, the exact payload the counterparty signs. Needs the party's `propose` scope.",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "party": {
                    "$ref": "#/components/schemas/Address"
                  },
                  "obligation": {
                    "type": "object"
                  },
                  "document": {
                    "type": "object"
                  },
                  "proposerRole": {
                    "enum": [
                      "debtor",
                      "creditor"
                    ]
                  },
                  "proposerSignature": {
                    "$ref": "#/components/schemas/Hex"
                  }
                },
                "required": [
                  "party",
                  "obligation",
                  "document",
                  "proposerRole",
                  "proposerSignature"
                ]
              }
            }
          }
        }
      }
    },
    "/obligations/proposals/{token}": {
      "get": {
        "summary": "Get a proposal",
        "description": "The proposal and the typed data its counterparty signs. Needs the party's `read` scope.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "party",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Address"
            },
            "description": "The party you're acting for. You need its read permission."
          }
        ]
      },
      "delete": {
        "summary": "Withdraw a proposal",
        "description": "Withdraws an open proposal. Needs the party's `propose` scope.",
        "responses": {
          "204": {
            "description": "No content"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "party",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Address"
            },
            "description": "The party you're acting for. You need its read permission."
          }
        ]
      }
    },
    "/obligations/proposals/{token}/accept": {
      "post": {
        "summary": "Accept a proposal",
        "description": "Records the obligation with the counterparty's signature. Needs the party's `deliverSignatures` scope.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "party": {
                    "$ref": "#/components/schemas/Address"
                  },
                  "signature": {
                    "$ref": "#/components/schemas/Hex"
                  }
                },
                "required": [
                  "party",
                  "signature"
                ]
              }
            }
          }
        }
      }
    },
    "/parties/{address}/obligations": {
      "get": {
        "summary": "List a party's obligations",
        "description": "Open proposals, recorded obligations with their remaining amounts, and certificates. Needs the party's `read` scope.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "address",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Address"
            }
          }
        ]
      }
    },
    "/parties/{address}/loops": {
      "post": {
        "summary": "Find a netting loop",
        "description": "Searches for a closed loop that includes the party and proposes a certificate if one exists. Needs the party's `propose` scope.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "address",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Address"
            }
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ]
      }
    },
    "/certificates/{token}": {
      "get": {
        "summary": "Get a certificate",
        "description": "The party's view (only its own obligations in full) and the typed data it signs. Needs the party's `read` scope.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "party",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Address"
            },
            "description": "The party you're acting for. You need its read permission."
          }
        ]
      }
    },
    "/certificates/{token}/signatures": {
      "post": {
        "summary": "Sign a certificate",
        "description": "Stores the party's signature after checking it against the chain. Needs the party's `deliverSignatures` scope.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "party": {
                    "$ref": "#/components/schemas/Address"
                  },
                  "signature": {
                    "$ref": "#/components/schemas/Hex"
                  }
                },
                "required": [
                  "party",
                  "signature"
                ]
              }
            }
          }
        }
      }
    },
    "/certificates/{token}/apply-transaction": {
      "get": {
        "summary": "Get the apply transaction",
        "description": "`to`, `data` and `value` for applying a fully signed certificate. Anyone may submit it; the sender pays the gas. 409 until every party has signed. Needs the party's `read` scope.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "party",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Address"
            },
            "description": "The party you're acting for. You need its read permission."
          }
        ]
      }
    },
    "/certificates/{token}/transactions": {
      "post": {
        "summary": "Report the apply transaction",
        "description": "Brings the certificate and its obligations up to date with the ledger. Needs the party's `read` scope.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "party": {
                    "$ref": "#/components/schemas/Address"
                  },
                  "txHash": {
                    "$ref": "#/components/schemas/Hex"
                  }
                },
                "required": [
                  "party",
                  "txHash"
                ]
              }
            }
          }
        }
      }
    },
    "/certificates/{token}/export": {
      "get": {
        "summary": "Export a certificate",
        "description": "The party's certificate file (`contraflow-netting-certificate/1`), checkable at /app/verify. Needs the party's `read` scope.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "party",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Address"
            },
            "description": "The party you're acting for. You need its read permission."
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "`Authorization: Bearer cfk_test_...`. Keys are issued by Contraflow."
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 255
        },
        "description": "Retrying with the same key returns the first response. Reusing it for a different request is a 409."
      }
    },
    "schemas": {
      "Address": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$"
      },
      "Hex": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]*$"
      },
      "Bytes32": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{64}$"
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "responses": {
      "Error": {
        "description": "An error. A party you have no permission for, and a row that doesn't exist, both answer 404.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "webhooks": {
    "event": {
      "post": {
        "summary": "Netting events",
        "description": "Sent to your registered URL with `Contraflow-Signature: t=<unix>,v1=<hex>`, an HMAC-SHA256 over `<t>.<raw body>` with your `whsec_` secret. Reject timestamps more than 5 minutes old, de-duplicate by `id`, and return 2xx quickly. Failed deliveries retry with backoff for 3 days. Types: obligation.recorded, certificate.proposed, certificate.ready, certificate.applied, certificate.expired, certificate.cancelled. Events only name parties that granted you the read scope.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  },
                  "created": {
                    "type": "integer"
                  },
                  "chainId": {
                    "type": "string"
                  },
                  "data": {
                    "type": "object"
                  }
                },
                "required": [
                  "id",
                  "type",
                  "created",
                  "data"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Received"
          }
        }
      }
    }
  }
}
